{% macro status(status) -%}
    {% if status == "ready" %}
    <span class="bg-gray-100 text-gray-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-gray-400 border border-gray-500">Ready</span>
    {% elif status == "queued" %}
    <span class="bg-yellow-100 text-yellow-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-yellow-300 border border-yellow-300">Queued</span>
    {% elif status == "running" %}
    <span class="bg-blue-100 text-blue-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-blue-400 border border-blue-400">Running</span>
    {% elif status == "done" %}
    <span class="bg-green-100 text-green-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-green-400 border border-green-400">Done</span>
    {% elif status == "completed" %}
    <span class="bg-green-100 text-green-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-green-400 border border-green-400">Completed</span>
    {% elif status == "failed" %}
    <span class="bg-red-100 text-red-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-red-400 border border-red-400">Failed</span>
    {% else %}
    <span class="bg-purple-100 text-purple-800 text-xs font-medium me-2 px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-purple-400 border border-purple-400">{{ status }} (?)</span>
    {% endif %}
{%- endmacro %}

{% macro jobs_table(jobs, table_id="jobs") -%}
<table id="{{ table_id }}" class="table-auto">
    <thead>
        <tr>
            <th>UUID</th>
            <th>Date</th>
            <th>Status</th>
            <th>Tags</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for job in jobs %}
        <tr>
            <td class="font-monospace"><a href="{{ url_for('job.view', id=job.id) }}" class="underline text-sky-600 hover:no-underline hover:text-sky-400">{{ job.id }}</a></td>
            <td class="font-monospace">{{ job.timestamp.strftime("%Y-%m-%d %H:%M:%S") }}</td>
            <td>{{ status(job.status) }}</td>
            <td>
                {% if job.virtual_path %}<strong>{{ job.virtual_path }}</strong><br>{% endif %}
                {% for tag in job.tags %}#{{ tag }} {% endfor %}
            </td>
            <td>
                <button type="button" class="underline text-sky-600 hover:no-underline hover:text-sky-400"
                    onclick="navigator.clipboard.writeText('{{ job.path }}')">Copy Path</button>
                <a href="/tensorboard/open/{{ job.id }}" target="_blank"
                    class="underline text-sky-600 hover:no-underline hover:text-sky-400">Tensorboard</a>
                {% if job.has_report %}
                <a href="{{ url_for('job.view', id=job.id, file='/output/report.html') }}" target="_blank"
                    class="underline text-sky-600 hover:no-underline hover:text-sky-400">Report</a>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<script>
    $(document).ready(function () {
        if ($.fn.DataTable.isDataTable('#{{ table_id }}')) {
            $('#{{ table_id }}').DataTable().destroy();
        }
        $('#{{ table_id }}').DataTable({ "order": [[1, 'desc']] });
    });
</script>
{%- endmacro %}
