<!DOCTYPE html>

<html>

<head>
    <title>Foreman</title>
    <meta http-equiv="Content-Type" content="text/html;charset=utf-8" />
    
    <link rel="stylesheet" href="{{ url_for('static', filename='output.css') }}" />
    <link rel="stylesheet" href="{{ url_for('static', filename='node_modules/datatables.net-dt/css/dataTables.dataTables.min.css') }}" />

    <!-- The Monaco Editor loader interferes with dataTables, so we have to include dataTables first -->
    <script src="{{ url_for('static', filename='node_modules/jquery/dist/jquery.min.js') }}"></script>
    <script src="{{ url_for('static', filename='node_modules/datatables.net/js/dataTables.js') }}"></script>   
    <script src="{{ url_for('static', filename='node_modules/htmx.org/dist/htmx.min.js') }}"></script>
    <script src="{{ url_for('static', filename='node_modules/monaco-editor/min/vs/loader.js') }}"></script>
</head>

<body>
    <div class="flex flex-col h-screen">
        <nav class="flex flex-row z-50 w-full bg-white border-b border-gray-200">
            <div class="w-64 p-4">
                <a class="" href="/">👷 Foreman</a>
            </div>
            <ul class="flex-1 flex flex-row font-medium bg-white">
                <li class="m-4">
                    <a class="hover:text-sky-600" href="{{ url_for('job_list.view') }}">Jobs</a>
                </li>
                <li class="m-4">
                    <a class="hover:text-sky-600" href="{{ url_for('job_tree.view') }}">Browse
                </li>
                <li class="m-4">
                    <a class="hover:text-sky-600" href="{{ url_for('search.index') }}">Search</a>
                </li>
            </ul>
        </nav>

        <main id="main" class="flex flex-row flex-1 overflow-y-auto bg-white">
            {% block sidebar %}{% endblock %}
            <div id="contents" class="{% if self.sidebar() %}sm:ml-64{% endif %} flex-1 px-4 py-4 overflow-y-auto">
                {% block contents %}{% endblock %}       
            </div>
        </main>
    </div>

    <div id="modal" class="fixed inset-0 z-50 flex justify-center items-center bg-black bg-opacity-50 hidden"></div>
    <script>
        function showModal() {
            document.getElementById('modal').classList.remove('hidden');
        }
    </script>
</body>

</html>
