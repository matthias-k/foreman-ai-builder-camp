
<ul>
    {%- for name, directory in directory_tree.items() recursive %}
    <li class="leading-8">
        {%- if directory.children %}
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="inline-block w-4 h-4 me-1 align-text-bottom">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg><a href="{{ url_for('job_tree.view', path=directory.path) }}" class="text-medium hover:text-sky-400">{{ name }}</a>
        {%- else %}
        <a href="{{ url_for('job_tree.view', path=directory.path) }}" class="ml-5 text-medium hover:text-sky-400">{{ name }}</a>
        {%- endif %}


        {%- if directory.children %}
        <ul class="pl-2">
            {{ loop(directory.children.items()) }}
        </ul>
        {%- endif %}
    </li>
    {%- endfor %}
</ul>
