{% extends "base.html" %}

{% block contents %}
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="flex flex-row text-gray-600 text-sm">
        <li>
            <a href="{{ url_for('job_tree.view') }}">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                    <path d="M11.47 3.841a.75.75 0 0 1 1.06 0l8.69 8.69a.75.75 0 1 0 1.06-1.061l-8.689-8.69a2.25 2.25 0 0 0-3.182 0l-8.69 8.69a.75.75 0 1 0 1.061 1.06l8.69-8.689Z" />
                    <path d="m12 5.432 8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 0 1-.75-.75v-4.5a.75.75 0 0 0-.75-.75h-3a.75.75 0 0 0-.75.75V21a.75.75 0 0 1-.75.75H5.625a1.875 1.875 0 0 1-1.875-1.875v-6.198a2.29 2.29 0 0 0 .091-.086L12 5.432Z" />
                </svg>
            </a>
        </li>

        {% for name, path in breadcrumbs.items() %}
        <li>
            &nbsp;/&nbsp;
            <a href="{{ url_for('job_tree.view', path=path) }}" class="underline text-sky-600 hover:no-underline hover:text-sky-400">{{ name }}</a>
        </li>
        {% endfor %}
    </ol>
</nav>

<table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
    <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
        <tr>
            <th scope="col" class="px-0 py-3"></th>
            <th scope="col" class="px-6 py-3 w-full">
                Name
            </th>
            <th scope="col" class="px-6 py-3">
                Date
            </th>
            <th scope="col" class="px-6 py-3">
                Status
            </th>
            <th scope="col" class="px-6 py-3">
                Actions
            </th>
        </tr>
    </thead>

    <tbody>
        {% for name, path in directories.items() %}
        <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
            <td>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
                    <path d="M19.5 21a3 3 0 0 0 3-3v-4.5a3 3 0 0 0-3-3h-15a3 3 0 0 0-3 3V18a3 3 0 0 0 3 3h15ZM1.5 10.146V6a3 3 0 0 1 3-3h5.379a2.25 2.25 0 0 1 1.59.659l2.122 2.121c.14.141.331.22.53.22H19.5a3 3 0 0 1 3 3v1.146A4.483 4.483 0 0 0 19.5 9h-15a4.483 4.483 0 0 0-3 1.146Z" />
                </svg>
            </td>
            <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white" id="folder-{{ loop.index }}">
                <a href="{{ url_for('job_tree.view', path=path) }}" class="underline text-sky-600 hover:no-underline hover:text-sky-400">{{ name }}</a>
            </th>
            <td></td>
            <td></td>
            <td>
                <button
                    hx-get="{{ url_for('job_tree.relocate_form', path=path) }}"
                    hx-target="#folder-{{ loop.index }}"
                    hx-swap="innerHTML"
                    class="underline text-sky-600 hover:no-underline hover:text-sky-400 group-hover/item:visible">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="inline w-4 h-4 me-1 align-text-bottom">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                    </svg>
                    Relocate
                </button>
            </td>
        </tr>
        {% endfor %}

        {% for name, entry in jobs.items() %}
        <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 group/item hover:bg-gray-50">
            <td></td>
            <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white" id="name-{{ entry[0].id }}">
                <a href="/jobs/{{ entry[0].id }}" class="underline text-sky-600 hover:no-underline hover:text-sky-400">
                    {{ name }}
                </a>
            </th>
            <td class="px-6 py-4 whitespace-nowrap">
                {{ entry[0].timestamp.strftime("%Y-%m-%d %H:%M:%S") }}
                {% if entry|length > 1 %}
                ( <a href="{{ url_for('job_tree.view_revisions', path=entry[0].virtual_path) }}" class="underline text-sky-600 hover:no-underline hover:text-sky-400">{{ entry|length }} revisions</a> )
                {% endif %}
            </td>
            <td class="px-6 py-4" hx-get="{{ url_for('job_status', id=entry[0].id) }}" hx-trigger="every 2s"></td>
            <td class="px-6 py-4 whitespace-nowrap">
                <button
                    hx-get="{{ url_for('job_tree.relocate_form', path=entry[0].virtual_path) }}"
                    hx-target="#name-{{ entry[0].id }}"
                    hx-swap="innerHTML"
                    class="underline text-sky-600 hover:no-underline hover:text-sky-400 group-hover/item:visible">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="inline w-4 h-4 me-1 align-text-bottom">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
                    </svg>
                    Relocate
                </button>

                <button type="button" class="underline text-sky-600 hover:no-underline hover:text-sky-400"
                    onclick="navigator.clipboard.writeText('{{ entry[0].path }}')">Copy Path</button>

                <a href="/tensorboard/open/{{ uuid }}" target="_blank"
                    class="underline text-sky-600 hover:no-underline hover:text-sky-400">Tensorboard</a>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endblock %}
