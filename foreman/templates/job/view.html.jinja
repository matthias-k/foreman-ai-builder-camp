{% extends "base.html.jinja" %}

{% import "macros.html.jinja" as macros %}

{% block sidebar %}
{% include "job/sidebar.html.jinja" %}
{% endblock %}

{% block contents %}
{% if open_file %}
<div hx-get="{{ url_for('job.view_file', id=job.id, path=open_file) }}" hx-target="#contents" hx-trigger="load" hx-swap="innerHTML"></div>
{% else %}
<nav aria-label="breadcrumb">
    <ol class="flex flex-row text-gray-600 text-sm">
        <li><a href="/" class="underline text-sky-600 hover:no-underline hover:text-sky-400">Jobs</a>&nbsp;/&nbsp;</li>
        <li aria-current="page">{{ job.id }}</li>
    </ol>
</nav>


<section class="mb-12">
    <h1 class="text-2xl mt-4 mb-8">
        {{ job.name or job.id}}
        {{ macros.status(job.status) }}
    </h1>

    {% if job.description %}
        <p>{{ job.description }}</p>
    {% endif %}
</section>


<section class="mb-12">
    <h2 class="text-xl px-2 mb-4">Metadata</h1>

    <table class="text-m text-left rtl:text-right text-gray-500 dark:text-gray-400">
        <tbody>
            <tr>
                <th class="align-top px-6 py-3 text-sm text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">Path</th>
                <td class="align-top px-6 py-3">
                    {{ job.path }}
                    <button type="button" class="underline text-sky-600 hover:no-underline hover:text-sky-400"
                    onclick="navigator.clipboard.writeText('{{ job.path }}')">Copy</button>
                </td>
            </tr>
            <tr>
                <th class="align-top px-6 py-3 text-sm text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">Tags</th>
                <td class="align-top px-6 py-3">
                    <ul class="list-unstyled">
                        {% for tag in job.tags %}<li>{{ tag }}</li>{% endfor %}
                    </ul>
                </td>
            </tr>
            <tr>
                <th class="align-top px-6 py-3 text-sm text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">Origin</th>
                <td class="align-top px-6 py-3">{{ job.origin }}</td>
            </tr>
        </tbody>
    </table>
</section>


<div>
    <h2 class="text-xl px-2 mb-4">Timeline</h1>

  <!-- https://flowbite.com/docs/components/tables/ -->
  <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
      <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
          <tr>
              <th scope="col" class="px-6 py-3">Date</th>
              <th scope="col" class="px-6 py-3">Time</th>
              <th scope="col" class="px-6 py-3">Duration</th>
              <th scope="col" class="px-6 py-3">Status</th>
              <th scope="col" class="px-6 py-3">Reason</th>
          </tr>
      </thead>
  
      <tbody>
          <!-- Normal variables in jinja2 are cleared after each loop iteration. -->
          {% set vars = namespace(last_date=None) %}
          {% for event in timeline %}
          <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700">
              <td class="px-6 py-4">
                  {% if vars.last_date != event.datetime.strftime("%Y-%m-%d") %}
                      {% set vars.last_date = event.datetime.strftime("%Y-%m-%d") %}
                      {{ event.datetime.strftime("%Y-%m-%d") }}
                  {% endif %}
              </td>
              <td class="px-6 py-4">{{ event.datetime.strftime("%H:%M:%S") }}</td>
              <td class="px-6 py-4">{{ event.duration }}</td>
              <td class="px-6 py-4">{{ macros.status(event.status) }}</td>
              <td class="px-6 py-4">
                  {% if event.reason == "committed" %}
                      Job {{ short_id }} was committed to R3.
                  {% elif event.reason == "submitted" %}
                      Slurm job {{ event.slurm_job_id }} was submitted.
                  {% elif event.reason == "preempted" %}
                      Slurm job {{ event.slurm_job_id }} was preempted.
                  {% elif event.status == "running" %}
                      Slurm job {{ event.slurm_job_id }} was started.
                  {% elif event.status == "done" %}
                      Slurm job {{ event.slurm_job_id }} completed.
                  {% else %}
                      {% if event.reason %}{{ event.reason }}{% endif %}
                      {% if event.slurm_job_id %} slurm_job_id = {{ event.slurm_job_id }}{% endif %}
                  {% endif %}
              </td>
          </tr>
          {% endfor %}
      </tbody>
  </table>
</div>
{% endif %}
{% endblock %}
